{
  "name": "@sazu/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.0.0 || ^22.0.0"
  },
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "migrate:up": "node-pg-migrate -m migrations --migration-file-language sql up",
    "migrate:down": "node-pg-migrate -m migrations --migration-file-language sql down",
    "migrate:create": "node-pg-migrate -m migrations --migration-file-language sql create",
    "admin:grant": "node dist/cli/grant-role.js",
    "admin:create": "node dist/cli/admin-create.js",
    "seed:dev": "node dist/cli/seed-dev.js",
    "admin:seller": "node dist/cli/seller-review.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^10.4.22",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "helmet": "^7.1.0",
    "node-pg-migrate": "^7.6.1",
    "nodemailer": "^10.1.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
